{
  "manifest_version": 3,
  "name": "CyberTraffic AI Monitor",
  "version": "1.0.0",
  "description": "Captures real browser traffic metadata and classifies it via XGBoost ML model on localhost:5002",
  "permissions": [
    "webRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CyberTraffic AI Monitor"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
